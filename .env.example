# Copy to .env (or pass via docker-compose/`docker run --env-file`) and
# fill in real values. Never commit the filled-in version — .gitignore
# already excludes `.env`.

# Postgres connection string — every user's accounts/files/chunks and the
# portal's login accounts all live in this one database now (e.g. a Neon
# DSN). Required by both `rhino serve` and every other CLI command.
# Prefer DATABASE_URL_FILE (path to a mounted secret file, e.g. a Docker
# secret) over this raw-value form when possible — see docker-compose.yml.
DATABASE_URL=
DATABASE_URL_FILE=

# 32 bytes, hex-encoded (64 hex characters) — encrypts every stored OAuth
# token at rest. Generate with: openssl rand -hex 32
# Losing this key means every connected Drive account needs reconnecting
# from scratch (there's no recovery — the tokens become undecryptable).
# Prefer RHINO_TOKEN_ENCRYPTION_KEY_FILE over this raw-value form when possible.
RHINO_TOKEN_ENCRYPTION_KEY=
RHINO_TOKEN_ENCRYPTION_KEY_FILE=

# Identifies which user's data the CLI (put/get/ls/rm/account/status)
# reads and writes — the same "users" table the web portal logs into.
# Pointing this at an existing portal username operates on that person's
# real data; a fresh name auto-provisions a CLI-only identity. Required —
# there's no default identity.
RHINO_USER=

# Address the HTTP server ("rhino serve") listens on.
RHINO_ADDR=:8080

# This deployment's externally-reachable base URL (e.g. a Render/your own
# domain's https://... URL). Defaults to http://localhost:8080. Used to
# build the Google OAuth redirect URL ({this}/api/accounts/oauth/callback)
# — must match a redirect URI registered on a Web application-type OAuth
# client in Google Cloud Console.
RHINO_PUBLIC_URL=

# Signs/encrypts session cookies. Required in production — without it, a
# random key is generated at startup and every session is invalidated on
# restart. Generate one with: openssl rand -base64 32
# Prefer RHINO_SESSION_SECRET_FILE (path to a mounted secret file, e.g. a
# Docker secret) over this raw-value form when possible.
RHINO_SESSION_SECRET=
RHINO_SESSION_SECRET_FILE=

# Used by the web portal ("rhino serve") only. Should be a "Web
# application" type Google OAuth client (fixed, pre-registered redirect
# URI — see README's setup notes), not the same credential the CLI uses.
# Defaults to <config dir>/rhino/client_secret.json if unset.
RHINO_CLIENT_SECRET=

# Used by every other CLI command ("account add", "put", "get", ...) only.
# Should be a "Desktop app" type Google OAuth client (loopback consent
# flow). Kept as a separate variable from RHINO_CLIENT_SECRET above so the
# CLI and the portal can each use their own OAuth client from one .env
# without one overriding the other. Defaults to <config dir>/rhino/client_secret.json
# if unset (same default as above, so a single client_secret.json works
# fine for local-only use where you don't need two separate credentials).
RHINO_CLI_CLIENT_SECRET=

# Set to 1 whenever the browser reaches this over HTTPS — whether this
# process terminates TLS itself or something in front of it does (Caddy,
# Render, any reverse proxy). Controls the session cookie's Secure flag.
# Leave unset only for plain-HTTP local dev.
RHINO_SESSION_SECURE=

# Only needed if this process terminates TLS directly instead of running
# behind a reverse proxy.
RHINO_TLS_CERT=
RHINO_TLS_KEY=

# Set to 1 to log every SQL statement GORM runs (verbose — debugging only).
RHINO_DB_LOG=
