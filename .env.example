# Copy to .env (or pass via docker-compose/`docker run --env-file`) and
# fill in real values. Never commit the filled-in version — .gitignore
# already excludes `.env`.

# Where the portal's users.db and per-user users/<id>/ data live. Inside a
# container this should point at a mounted, persistent volume.
RHINO_DATA_DIR=/data

# Address the HTTP server listens on.
RHINO_ADDR=:8080

# Signs/encrypts session cookies. Required in production — without it, a
# random key is generated at startup and every session is invalidated on
# restart. Generate one with: openssl rand -base64 32
# Prefer RHINO_SESSION_SECRET_FILE (path to a mounted secret file, e.g. a
# Docker secret) over this raw-value form when possible.
RHINO_SESSION_SECRET=
RHINO_SESSION_SECRET_FILE=

# Used by the web portal ("rhino serve") only. Should be a "Web
# application" type Google OAuth client (fixed, pre-registered redirect
# URI — see README's setup notes), not the same credential the CLI uses.
# Defaults to RHINO_DATA_DIR/client_secret.json if unset.
RHINO_CLIENT_SECRET=

# Used by every other CLI command ("account add", "put", "get", ...) only.
# Should be a "Desktop app" type Google OAuth client (loopback consent
# flow). Kept as a separate variable from RHINO_CLIENT_SECRET above so the
# CLI and the portal can each use their own OAuth client from one .env
# without one overriding the other. Defaults to
# RHINO_DATA_DIR/client_secret.json if unset (same default as above, so a
# single client_secret.json works fine for local-only use where you don't
# need two separate credentials).
RHINO_CLI_CLIENT_SECRET=

# Set to 1 only if this process itself terminates TLS (uncommon — the
# default deployment terminates TLS at a reverse proxy in front of it, see
# Caddyfile/docker-compose.yml).
RHINO_SESSION_SECURE=

# Only needed if this process terminates TLS directly instead of running
# behind a reverse proxy.
RHINO_TLS_CERT=
RHINO_TLS_KEY=
